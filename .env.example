# Plugin Environment Variables
# Copy this file to .env and fill in the values for plugins you want to test

# Pixabay Plugin
PIXABAY_API_KEY=your_pixabay_api_key

# Weather Plugin (optional)
WEATHER_DEFAULT_CITY=Paris

SNOWFLAKE_OAUTH_CLIENT_SECRET=your_snowflake_oauth_client_secret
SNOWFLAKE_OAUTH_CLIENT_ID=your_snowflake_oauth_client_id