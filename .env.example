# Plugin Environment Variables
# Copy this file to .env and fill in the values for plugins you want to test

# Pixabay Plugin
PIXABAY_API_KEY=your_pixabay_api_key

# Staan Plugin (fallback — the key is normally set in the plugin config)
STAAN_API_KEY=your_staan_api_key

# Weather Plugin (optional)
WEATHER_DEFAULT_CITY=Paris

# Atlassian Plugin (headless fallback — authMode "api_token"; OAuth mode needs no env)
ATLASSIAN_API_TOKEN=your_atlassian_api_token_or_service_account_key
ATLASSIAN_API_TOKEN_EMAIL=you@example.com  # only for personal API tokens (Basic auth); leave empty for service-account keys
